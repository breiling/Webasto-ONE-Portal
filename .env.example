# WSD Flow Validator — environment configuration
# Copy this file to .env and fill in your values.
# Never commit .env to source control.

# ── CRM / Integration Layer ─────────────────────────────────────────────────

# Base URL of the Integration Layer REST API (no trailing slash)
CRM_BASE_URL=https://your-integration-layer.example.com/api/v1

# Auth mode: "api_key" (simple REST) or "oauth2" (Azure AD client credentials)
CRM_AUTH_MODE=api_key

# Required when CRM_AUTH_MODE=api_key
CRM_API_KEY=

# Required when CRM_AUTH_MODE=oauth2 (Azure AD / Dynamics 365)
CRM_TENANT_ID=
CRM_CLIENT_ID=
CRM_CLIENT_SECRET=

# ── SLA Thresholds (hours) ──────────────────────────────────────────────────

# Hours of inactivity before a request is flagged DELAYED
SLA_WARNING_HOURS=24

# Hours of inactivity before a request is flagged STUCK
SLA_CRITICAL_HOURS=48

# Hours of inactivity before a request is flagged ESCALATION NEEDED
SLA_ESCALATION_HOURS=72

# ── Retry / Timeout settings ─────────────────────────────────────────────────

REQUEST_TIMEOUT_SECONDS=30
MAX_RETRIES=4
RETRY_BASE_DELAY_SECONDS=2.0
